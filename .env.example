# Salin file ini menjadi .env lalu isi API key sesuai exchange yang dipakai.

# --- Binance USDT-M Futures ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Bybit USDT-M Futures ---
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- OKX USDT-M Futures ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- AI/LLM (opsional, untuk strategi ai_signal) ---
# OpenAI-compatible endpoint (OpenAI, DeepSeek, Groq, dsb.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Telegram alert (opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
