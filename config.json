{
  "exchange": {
    "name": "binance",
    "testnet": true,
    "options": {
      "defaultType": "swap",
      "defaultSubType": "linear",
      "adjustForTimeDifference": true
    }
  },
  "symbols": ["BTC/USDT:USDT", "ETH/USDT:USDT"],
  "timeframe": "15m",

  "trend_filter": {
    "enabled": true,
    "timeframe": "1h",
    "ema_fast": 21,
    "ema_slow": 50,
    "symbols": []
  },

  "risk": {
    "max_position_pct": 20,
    "max_total_exposure_pct": 60,
    "leverage": 3,
    "max_leverage": 5,
    "take_profit_pct": 2.0,
    "stop_loss_pct": 1.0,
    "trailing_stop_pct": 1.5,
    "daily_loss_limit_pct": 5.0,
    "min_equity_usdt": 20,
    "max_open_positions": 3,
    "min_fee_tolerance_pct": 0.15,
    "use_atr_stops": true,
    "atr_period": 14,
    "atr_stop_mult": 1.5,
    "atr_tp_mult": 2.5,
    "adaptive_sizing": true,
    "atr_normal_pct": 1.0,
    "size_volatility_bounds": [0.5, 2.0]
  },

  "strategies": {
    "momentum": {
      "enabled": true,
      "ema_fast": 9,
      "ema_slow": 21,
      "rsi_period": 14,
      "rsi_oversold": 30,
      "rsi_overbought": 70,
      "require_rsi_filter": true,
      "cooldown_seconds": 900
    },
    "ai_signal": {
      "enabled": false,
      "model": "gpt-4o-mini",
      "base_url": "https://api.openai.com/v1",
      "prompt_template": "Berikan keputusan trading untuk {symbol} pada timeframe {timeframe}. Data teknikal: {indicators}. Sentimen berita: {news}. Jawab hanya satu kata: LONG, SHORT, atau NEUTRAL, lalu berikan confidence 0-100 dalam format JSON.",
      "confidence_threshold": 65,
      "news_api_url": "",
      "min_interval_seconds": 60,
      "news_max_chars": 500
    },
    "grid": {
      "enabled": false,
      "grid_levels": 10,
      "grid_spacing_pct": 0.5,
      "max_grid_orders": 20,
      "grid_per_level_pct": 0.5,
      "grid_rebuild_drift_pct": 3.0
    }
  },

  "execution": {
    "order_type": "market",
    "position_mode": "one-way",
    "reduce_only_on_close": true,
    "retry_attempts": 3,
    "entry_ttl_seconds": 180,
    "poll_interval_seconds": 60,
    "one_position_per_symbol": true
  },

  "telegram": {
    "enabled": false,
    "bot_token": "",
    "chat_id": ""
  },

  "screener": {
    "timeframe": "1h",
    "max_coins": 10,
    "min_volume_usdt": 0
  },

  "reporting": {
    "daily_hour": 8
  },

  "logging": {
    "level": "INFO",
    "file": "logs/agent.log"
  }
}
