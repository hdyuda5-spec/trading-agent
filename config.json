{
  "exchange": {
    "name": "binance",
    "testnet": true,
    "options": {
      "defaultType": "swap",
      "defaultSubType": "linear",
      "adjustForTimeDifference": true
    }
  },
  "symbols": ["BTC/USDT:USDT", "ETH/USDT:USDT"],
  "timeframe": "15m",

  "trading": {
    "mode": "paper",
    "paper": {
      "initial_balance_usdt": 1000,
      "fee_pct": 0.05
    }
  },

  "decision": {
    "min_margin": 0.15,
    "thresholds": {
      "long": 0.0,
      "short": 0.0
    },
    "ticket_ttl_seconds": 300,
    "regime": {
      "high_vol_atr_pct": 2.0,
      "adx_min": 20
    },
    "weights": {
      "ai_advisory": 0.20,
      "technical": 2,
      "trend": 2,
      "momentum": 1,
      "liquidity": 3,
      "order_flow": 2,
      "whale": 1,
      "pattern": 1,
      "news": 1
    }
  },

  "trend_filter": {
    "enabled": true,
    "timeframe": "1h",
    "ema_fast": 21,
    "ema_slow": 50,
    "adx_filter": {
      "enabled": false,
      "period": 14,
      "min_adx": 20
    },
    "symbols": []
  },

  "risk": {
    "max_position_pct": 20,
    "max_total_exposure_pct": 60,
    "leverage": 3,
    "max_leverage": 5,
    "take_profit_pct": 2.0,
    "stop_loss_pct": 1.0,
    "min_stop_distance_pct": 0.3,
    "min_tp_distance_pct": 0.5,
    "trailing_stop_pct": 1.2,
    "use_atr_trailing": true,
    "atr_trailing_mult": 1.5,
    "daily_loss_limit_pct": 5.0,
    "min_equity_usdt": 20,
    "max_open_positions": 2,
    "skip_after_consecutive_losses": 2,
    "min_fee_tolerance_pct": 0.15,
    "use_atr_stops": true,
    "atr_period": 14,
    "atr_stop_mult": 1.5,
    "atr_tp_mult": 2.5,
    "sl_fixed_pct": 2.5,
    "tp_fixed_pct": 3.0,
    "max_stop_distance_pct": 3.0,
    "adaptive_sizing": true,
    "atr_normal_pct": 1.0,
    "size_volatility_bounds": [0.5, 1.5],
    "fixed_notional_usdt": 2,
    "fixed_notional_max_equity_usdt": 100
  },

  "strategies": {
    "momentum": {
      "enabled": false,
      "ema_fast": 9,
      "ema_slow": 21,
      "rsi_period": 14,
      "rsi_oversold": 30,
      "rsi_overbought": 70,
      "require_rsi_filter": true,
      "cooldown_seconds": 900,
      "sr_filter": {
        "enabled": true,
        "window": 3,
        "cluster_pct": 0.5,
        "zone_pct": 0.6,
        "zone_atr_mult": 0.5,
        "directions": {
          "LONG": true,
          "SHORT": true
        },
        "symbols": {}
      }
    },
    "ai_signal": {
      "enabled": false,
      "model": "openai/gpt-4o-mini",
      "base_url": "https://openrouter.ai/api/v1",
      "json_mode": true,
      "prompt_template": "Analisislah {symbol} pada timeframe {timeframe} untuk keperluan advisory. Data teknikal: {indicators}. Sentimen berita: {news}. Pelajaran dari trade masa lalu bot: {lessons}. Gunakan pelajaran itu untuk menghindari pola yang pernah gagal dan pertahankan pola yang pernah berhasil. JANGAN merekomendasikan posisi beli/jual; kamu hanya penasihat. Keluarkan HANYA satu objek JSON tanpa teks lain dengan skema: {\"market_summary\": string, \"trend\": \"bullish\"|\"bearish\"|\"neutral\", \"macro\": string, \"news\": string, \"risk\": string, \"confidence\": number 0-100}.",
      "debate": {
        "enabled": true,
        "bull_prompt": "",
        "bear_prompt": "",
        "arbiter_prompt": ""
      },
      "reflection": {
        "enabled": true,
        "max_workers": 1,
        "lesson_max_chars": 500
      },
      "confidence_threshold": 75,
      "rsi_confirmation": true,
      "rsi_long_range": [40, 75],
      "rsi_short_range": [25, 60],
      "news_api_url": "",
      "min_interval_seconds": 300,
      "news_max_chars": 500
    },
    "mean_reversion": {
      "enabled": false,
      "bb_period": 20,
      "bb_std": 2,
      "rsi_period": 14,
      "rsi_oversold": 30,
      "rsi_overbought": 70
    },
    "support_resistance": {
      "enabled": true,
      "zone_pct": 0.8,
      "min_distance_pct": 0.3,
      "require_reversal": true,
      "cooldown_seconds": 900,
      "oppose_limit": -0.5,
      "directions": {
        "LONG": true,
        "SHORT": true
      }
    },
    "grid": {
      "enabled": false,
      "grid_levels": 10,
      "grid_spacing_pct": 0.5,
      "max_grid_orders": 20,
      "grid_per_level_pct": 0.5,
      "grid_rebuild_drift_pct": 3.0
    }
  },

  "execution": {
    "order_type": "limit",
    "position_mode": "one-way",
    "order_ttl_seconds": 300,
    "reduce_only_on_close": true,
    "retry_attempts": 3,
    "entry_ttl_seconds": 180,
    "poll_interval_seconds": 60,
    "one_position_per_symbol": true
  },

  "telegram": {
    "enabled": false,
    "bot_token": "",
    "chat_id": ""
  },

  "screener": {
    "timeframe": "1h",
    "max_coins": 20,
    "min_volume_usdt": 5000000,
    "exclude_symbols": [
      "XAU/USDT:USDT",
      "MU/USDT:USDT",
      "SNDK/USDT:USDT",
      "TUT/USDT:USDT",
      "SOXL/USDT:USDT",
      "SNXX/USDT:USDT",
      "SPCX/USDT:USDT",
      "KOMA/USDT:USDT",
      "BLESS/USDT:USDT"
    ],
    "enabled": true,
    "auto_interval_minutes": 30,
    "no_trade_hours_wib": [2, 7, 10, 11, 13, 20],
    "top_signal_cards": 3,
    "auto_trade": false,
    "top_trade_candidates": 3,
    "rsi_confirmation": true,
    "rsi_long_range": [40, 75],
    "rsi_short_range": [25, 60],
    "require_confirmation": true,
    "max_extended_pct": 15,
    "news": [],
    "scoring": {
      "min_confidence": 0.6,
      "min_margin": 0.1,
      "weights": {
        "liquidity": 0.25,
        "structure": 0.2,
        "trend": 0.15,
        "volume": 0.15,
        "funding": 0.1,
        "open_interest": 0.1,
        "whale": 0.05
      },
      "rsi_bonus": 0.03,
      "rsi_max_penalty": 0.12,
      "sentiment_max_adjust": 0.1,
      "news_max_adjust": 0.1,
      "streak_penalty": 0.08,
      "max_buy_chg_pct": 10,
      "regime_penalty": 0.1,
      "extreme_move_max_penalty": 0.2
    }
  },

  "pattern": {
    "enabled": true
  },

  "smart_money": {
    "enabled": true,
    "cvd_trades_limit": 500,
    "orderbook_depth": 10
  },

  "features": {
    "enabled": [
      "trend",
      "volatility",
      "volume",
      "liquidity",
      "structure",
      "whale",
      "sentiment",
      "funding",
      "open_interest"
    ],
    "market_cache_ttl": 300,
    "trend": {
      "mode": "ema_cross",
      "ema_fast": 21,
      "ema_slow": 50,
      "adx_enabled": false,
      "adx_period": 14,
      "min_adx": 20
    },
    "volatility": {
      "atr_period": 14,
      "bb_period": 20,
      "bb_std": 2
    },
    "structure": {
      "sr_window": 3,
      "sr_cluster_pct": 0.5,
      "zone_pct": 0.6
    },
    "liquidity": {
      "orderbook_depth": 10
    },
    "funding": {
      "extreme_rate": 0.0001
    },
    "open_interest": {
      "timeframe": "1h",
      "history_limit": 20
    }
  },

  "whale": {
    "enabled": true,
    "interval_minutes": 30,
    "min_notional_usdt": 50000,
    "max_coins": 15,
    "window_minutes": 30,
    "min_alert_net_usdt": 50000,
    "filter_trades": true,
    "min_whale_txns": 2,
    "market_regime": {
      "enabled": true,
      "net_sell_threshold_usdt": 1000000,
      "min_symbols": 5
    }
  },

  "reporting": {
    "daily_hour": 8
  },

  "logging": {
    "level": "INFO",
    "file": "logs/agent.log"
  }
}
