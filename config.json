{
  "exchange": {
    "name": "binance",
    "testnet": false,
    "options": {
      "defaultType": "swap",
      "defaultSubType": "linear",
      "adjustForTimeDifference": true
    }
  },
  "symbols": ["BNB/USDT:USDT"],
  "timeframe": "15m",

  "decision": {
    "min_margin": 0.15,
    "weights": {
      "ai_advisory": 0.20
    }
  },

  "trend_filter": {
    "enabled": true,
    "timeframe": "1h",
    "ema_fast": 21,
    "ema_slow": 50,
    "adx_filter": {
      "enabled": false,
      "period": 14,
      "min_adx": 20
    },
    "symbols": []
  },

  "risk": {
    "max_position_pct": 10,
    "max_total_exposure_pct": 30,
    "leverage": 5,
    "max_leverage": 5,
    "take_profit_pct": 2.0,
    "stop_loss_pct": 1.0,
    "min_stop_distance_pct": 0.3,
    "min_tp_distance_pct": 0.5,
    "trailing_stop_pct": 1.2,
    "use_atr_trailing": true,
    "atr_trailing_mult": 1.5,
    "daily_loss_limit_pct": 5.0,
    "min_equity_usdt": 20,
    "max_open_positions": 2,
    "skip_after_consecutive_losses": 2,
    "min_fee_tolerance_pct": 0.15,
    "use_atr_stops": true,
    "atr_period": 14,
    "atr_stop_mult": 1.0,
    "atr_tp_mult": 2.5,
    "adaptive_sizing": true,
    "atr_normal_pct": 1.0,
    "size_volatility_bounds": [0.8, 1.5]
  },

  "strategies": {
    "momentum": {
      "enabled": false,
      "ema_fast": 9,
      "ema_slow": 21,
      "rsi_period": 14,
      "rsi_oversold": 30,
      "rsi_overbought": 70,
      "require_rsi_filter": true,
      "cooldown_seconds": 900,
      "sr_filter": {
        "enabled": true,
        "window": 3,
        "cluster_pct": 0.5,
        "zone_pct": 0.6,
        "zone_atr_mult": 0.5,
        "directions": {
          "LONG": true,
          "SHORT": true
        },
        "symbols": {
          "SOL/USDT:USDT": {
            "enabled": false
          }
        }
      }
    },
    "ai_signal": {
 "enabled": false,
 "model": "openai/gpt-4o-mini",
 "base_url": "https://openrouter.ai/api/v1",
 "json_mode": true,
      "prompt_template": "Analisislah {symbol} pada timeframe {timeframe} untuk keperluan advisory. Data teknikal: {indicators}. Sentimen berita: {news}. Pelajaran dari trade masa lalu bot: {lessons}. Gunakan pelajaran itu untuk menghindari pola yang pernah gagal dan pertahankan pola yang pernah berhasil. JANGAN merekomendasikan posisi beli/jual; kamu hanya penasihat. Keluarkan HANYA satu objek JSON tanpa teks lain dengan skema: {\"market_summary\": string, \"trend\": \"bullish\"|\"bearish\"|\"neutral\", \"macro\": string, \"news\": string, \"risk\": string, \"confidence\": number 0-100}.",
      "debate": {
        "enabled": true,
        "bull_prompt": "",
        "bear_prompt": "",
        "arbiter_prompt": ""
      },
      "reflection": {
        "enabled": true,
        "max_workers": 1,
        "lesson_max_chars": 500
      },
      "confidence_threshold": 75,
      "rsi_confirmation": true,
      "rsi_long_range": [40, 75],
      "rsi_short_range": [25, 60],
      "news_api_url": "",
      "min_interval_seconds": 300,
      "news_max_chars": 500
    },
    "mean_reversion": {
      "enabled": false,
      "bb_period": 20,
      "bb_std": 2,
      "rsi_period": 14,
      "rsi_oversold": 30,
      "rsi_overbought": 70
    },
    "grid": {
      "enabled": false,
      "grid_levels": 10,
      "grid_spacing_pct": 0.5,
      "max_grid_orders": 20,
      "grid_per_level_pct": 0.5,
      "grid_rebuild_drift_pct": 3.0
    }
  },

  "execution": {
    "order_type": "limit",
    "position_mode": "one-way",
    "order_ttl_seconds": 300,
    "reduce_only_on_close": true,
    "retry_attempts": 3,
    "entry_ttl_seconds": 180,
    "poll_interval_seconds": 60,
    "one_position_per_symbol": true
  },

  "telegram": {
    "enabled": true,
    "bot_token": "",
    "chat_id": ""
  },

  "screener": {
    "timeframe": "1h",
    "max_coins": 20,
    "min_volume_usdt": 5000000,
    "exclude_symbols": [
      "XAU/USDT:USDT",
      "MU/USDT:USDT"
    ],
    "enabled": true,
    "auto_interval_minutes": 30,
    "top_signal_cards": 3,
    "auto_trade": false,
    "top_trade_candidates": 3,
    "rsi_confirmation": true,
    "rsi_long_range": [40, 75],
    "rsi_short_range": [25, 60],
    "require_confirmation": true,
    "max_extended_pct": 30
  },

  "pattern": {
    "enabled": true
  },

  "smart_money": {
    "enabled": true,
    "cvd_trades_limit": 500,
    "orderbook_depth": 10
  },

  "features": {
    "enabled": [
      "trend",
      "volatility",
      "volume",
      "liquidity",
      "structure",
      "whale",
      "sentiment",
      "funding"
    ],
    "market_cache_ttl": 300,
    "trend": {
      "mode": "ema_cross",
      "ema_fast": 21,
      "ema_slow": 50,
      "adx_enabled": false,
      "adx_period": 14,
      "min_adx": 20
    },
    "volatility": {
      "atr_period": 14,
      "bb_period": 20,
      "bb_std": 2
    },
    "structure": {
      "sr_window": 3,
      "sr_cluster_pct": 0.5,
      "zone_pct": 0.6
    },
    "liquidity": {
      "orderbook_depth": 10
    },
    "funding": {
      "extreme_rate": 0.0001
    }
  },

  "whale": {
    "enabled": true,
    "interval_minutes": 30,
    "min_notional_usdt": 50000,
    "max_coins": 15,
    "window_minutes": 30,
    "min_alert_net_usdt": 50000,
    "filter_trades": true,
    "min_whale_txns": 2,
    "market_regime": {
      "enabled": true,
      "net_sell_threshold_usdt": 1000000,
      "min_symbols": 5
    }
  },

  "reporting": {
    "daily_hour": 8
  },

  "logging": {
    "level": "INFO",
    "file": "logs/agent.log"
  }
}
